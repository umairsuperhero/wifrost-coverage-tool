# WiFrost Frontend — environment variables
# For local dev:  copy this file to .env.local  (Next.js loads it automatically)
# For Vercel:     baked at build time from committed .env.production + vercel.json
#                 (NEXT_PUBLIC_* is compiled into the client bundle — a rebuild is
#                 required to change it; a dashboard-only var will not take effect
#                 because the committed files take precedence). See DEPLOYMENT.md.
# For Docker:     passed as a build-arg in docker-compose.yml (see docker-compose.yml)

# URL of the WiFrost FastAPI backend.
# Local dev:   http://127.0.0.1:8000
# Production:  https://wifrost-api-508425876629.northamerica-south1.run.app  (Google Cloud Run)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
